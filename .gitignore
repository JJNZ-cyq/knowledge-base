# ─── 大文件绝不入库（见 docs/设计方案.md §8.1）───
*.pdf
*.zip
*.7z
*.mp4
*.mov
*.iso
*.exe

# ─── Obsidian 本机状态 ───
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# ─── 系统与临时文件 ───
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
*.bak

# ─── 日志（运行环境与工具会生成，不要入库）───
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# ─── Node ───
node_modules/
